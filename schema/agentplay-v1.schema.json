    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "segments",
              "turns",
              null
            ]
          },
          "startSeq": {
            "type": [
              "integer",
              "null"
            ]
          },
          "endSeq": {
            "type": [
              "integer",
              "null"
            ]
          },
          "startT": {
            "type": [
              "number",
              "null"
            ]
          },
          "endT": {
            "type": [
              "number",
              "null"
            ]
          },
          "firstTurn": {
            "type": [
              "number",
              "null"
            ]
          },
          "lastTurn": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "n"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scope": {
          "const": "outside"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "touch": {
          "enum": [
            "hit",
            "read",
            "edit"
          ]
        },
        "op": {
          "enum": [
            "create",
            "modify",
            "delete",
            "rename-from",
            "rename-to",
            null
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "touch"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "ms since the first event"
        },
        "kind": {
          "type": "string",
          "description": "read|search|edit|exec|verify|mcp|skill|subagent|web|tool|llm|error|delay|user|compaction|commit|pr_merge|pr_close|pr_comment|ticket|artifact|skill_write|model_switch"
        },
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "description": "'main' or a subagent id from agents[]"
        },
        "err": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "verb": {
          "type": [
            "string",
            "null"
          ],
          "description": "shell verb only, e.g. 'git log'; never arguments"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "vcs": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "number": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true,
          "required": [
            "provider",
            "action"
          ]
        },
        "cat": {
          "enum": [
            "file",
            "shell",
            "vcs",
            "test",
            "cloud",
            "http",
            "fs",
            "package",
            "build",
            "mcp",
            "subagent",
            "skill",
            "web",
            "tool",
            null
          ]
        },
        "outBytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "dur": {
          "type": [
            "number",
            "null"
          ]
        },
        "server": {
