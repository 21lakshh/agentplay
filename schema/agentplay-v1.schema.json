            "type": [
              "number",
              "null"
            ]
          },
          "requests": {
            "type": [
              "number",
              "null"
            ]
          },
          "tokens": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost": {
            "type": [
              "number",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          }
        },
