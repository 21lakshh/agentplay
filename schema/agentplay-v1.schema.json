            "number",
            "null"
          ]
        },
        "errorsBySource": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "errorsByClass": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
