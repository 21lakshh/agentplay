{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Entelligence-AI/agentplay/schema/agentplay-v1.schema.json",
  "title": "agentplay/v1",
  "description": "A redacted, chronological replay of one coding-agent session. Contains no prompt text, model output, tool inputs or outputs, file contents or command arguments. See docs/format.md.",
  "type": "object",
  "required": [
    "schema",
    "session",
    "totals",
    "events"
  ],
  "properties": {
    "schema": {
      "enum": [
        "agentplay/v1",
        "entelligence.session-map/v1"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "agentTool": {
          "type": [
            "string",
            "null"
          ],
          "description": "claude-code | codex | cursor | copilot | copilot-vscode | opencode | kiro | ..."
        },
        "cliVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pathMode": {
          "enum": [
            "relative",
            "dirs_only",
            "hashed",
            null
          ]
        },
        "truncated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "description": "pr_created | verified | blocked | interrupted | unresolved_errors | completed | incomplete"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "description": "root | subagent | helper | unknown"
        },
        "parentSessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "startedAt"
      ]
    },
    "totals": {
      "type": "object",
      "properties": {
        "calls": {
          "type": [
            "number",
            "null"
          ]
        },
        "requests": {
          "type": [
            "number",
            "null"
          ]
        },
        "userTurns": {
          "type": [
            "number",
            "null"
          ]
        },
        "subagents": {
          "type": [
            "number",
            "null"
          ]
        },
        "errors": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "filesTouched": {
          "type": [
            "number",
            "null"
          ]
        },
        "retries": {
          "type": [
            "number",
            "null"
          ]
        },
        "delays": {
          "type": [
            "number",
            "null"
          ]
        },
        "delayMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxContext": {
          "type": [
            "number",
            "null"
          ]
        },
        "compactions": {
          "type": [
            "number",
            "null"
          ]
        },
        "llmLatencyP50": {
          "type": [
            "number",
            "null"
          ]
