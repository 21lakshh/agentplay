        "commits": {
          "type": [
            "number",
            "null"
          ]
        },
        "prsMerged": {
          "type": [
            "number",
            "null"
          ]
        },
        "prsClosed": {
          "type": [
            "number",
            "null"
          ]
        },
        "prComments": {
          "type": [
            "number",
            "null"
          ]
        },
        "ticketsCreated": {
          "type": [
            "number",
            "null"
          ]
        },
        "ticketsUpdated": {
          "type": [
            "number",
            "null"
          ]
        },
        "artifacts": {
          "type": [
            "number",
            "null"
          ]
        },
        "skillsCreated": {
          "type": [
            "number",
            "null"
          ]
